# Graphwarden Environment Configuration

# Database Connection (PostgreSQL or SQLite Fallback)
DATABASE_URL=sqlite:///./graphwarden.db
# DATABASE_URL=postgresql://graphwarden:graphwarden_secure_pass@localhost:5432/graphwarden

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Security & Tokens
JWT_SECRET=graphwarden_secret_forensic_key_2026

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=graphwarden
MINIO_ROOT_PASSWORD=minio_secret_key

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
